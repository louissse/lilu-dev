---
interface Props {
  text: string;
  href?: string;
  variant?: "primary" | "secondary";
  [key: string]: unknown;
}

const { text, href = "#", variant = "primary", ...rest } = Astro.props;
---

{
  variant === "primary" ? (
    <a href={href}>
      <span class="shadow" />
      <span class="front">{text}</span>
    </a>
  ) : (
    ""
  )
}
{
  variant === "secondary" ? (
    <a href={href}>
      <span class="secondary shadow" />
      <span class="front secondary">{text}</span>
    </a>
  ) : (
    ""
  )
}
<style>
  a {
    display: inline-flex;
    justify-content: center; /* center the content horizontally */
    align-items: center;
    position: relative;
    text-decoration: none;
    text-align: center;
  }
  .front {
    position: relative;
    display: block;
    border-radius: 25px;
    font-size: var(--text-lg);
    line-height: var(--text-lg--line-height);
    padding: calc(var(--spacing) * 2) calc(var(--spacing) * 5);
    background: color-mix(in srgb, var(--color-red-700) 70%, transparent);
    color: var(--color-orange-50);
    font-weight: var(--font-weight-medium);
    transform: translateY(-1px);
    transition: transform 600ms cubic-bezier(0.3, 0.7, 0.4, 1);
  }
  .front.secondary {
    background: color-mix(in srgb, var(--color-orange-300) 70%, transparent);
    color: var(--color-blue-900);
  }

  .shadow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 25px;
    background: var(--color-red-950);
    opacity: 0.3;
    filter: blur(1px);
    transform: translateY(2px);
  }
  .shadow.secondary {
    background: var(--color-orange-950);
    opacity: 0.2;
  }

  a:hover .shadow {
    transform: translateY(3px);
    filter: blur(1.5px);
    transition: transform 250ms cubic-bezier(0.3, 0.7, 0.4, 1.5);
  }
  a:hover .front {
    transform: translateY(-2px);
    transition: transform 250ms cubic-bezier(0.3, 0.7, 0.4, 1.5);
  }
  a:active .front {
    transform: translateY(0px);
    transition: transform 34ms;
  }
  a:active .shadow {
    transform: translateY(2px);
    filter: blur(1px);
    opacity: 0.4;
    transition:
      transform 34ms,
      opacity 34ms;
  }
</style>
